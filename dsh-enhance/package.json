{
  "name": "@local/dsh-enhance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bottom terminal dock with persistent multi-shell tabs, backed by ttyd.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "badges.json",
    "decorators.json",
    "locale/*.json",
    "icon.svg",
    "docs",
    "groups.json",
    "config.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
